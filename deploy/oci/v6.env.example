# Copie este archivo a .env en la VM. NO lo suba a GitHub.
TRADER_ACCESS_CONFIRMED=no

# Telegram ya existente. Copiar manualmente desde sus secretos, nunca por chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Binance HMAC SOLO LECTURA. Dejar vacío hasta que el preflight público sea exitoso.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Cree un token aleatorio largo para comunicación interna app↔bridge.
BINANCE_BRIDGE_TOKEN=
